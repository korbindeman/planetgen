{
    "name": "@redblobgames/1843-planet-generation",
    "version": "1.0.0",
    "workspaces": [
        "packages/*"
    ],
    "dependencies": {
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@redblobgames/dual-mesh": "https://github.com/redblobgames/dual-mesh",
        "@redblobgames/prng": "https://github.com/redblobgames/prng",
        "delaunator": "^3.0",
        "gl-matrix": "2.8.1",
        "hash-int": "1.0.0",
        "htm": "^3.1.1",
        "preact": "^10.29.8",
        "regl": "1.3.7",
        "simplex-noise": "^2"
    },
    "license": "Apache-2.0",
    "packageManager": "bun@1.3.14",
    "private": true,
    "scripts": {
        "dev": "bun ./scripts/dev.mjs",
        "sync:td": "bun ./scripts/sync-td-overlays.mjs",
        "td-server": "bun ./scripts/td-server.mjs",
        "preview": "bun ./scripts/preview.mjs",
        "crop": "bun ./scripts/crop.mjs",
        "seam": "bun ./scripts/seam-corner.mjs",
        "stats": "bun ./scripts/tectonics-stats.mjs",
        "sheet": "bun ./scripts/seed-sheet.mjs",
        "sheet:layout": "bun ./scripts/layout-sheet.mjs",
        "check:layout": "bun ./scripts/check-layout-history.mjs",
        "climate": "bun ./scripts/climate-stats.mjs",
        "finish:climate": "bun ./scripts/finish-climate.mjs",
        "preview:climate": "bun ./scripts/preview-climate.mjs",
        "sheet:climate": "bun ./scripts/climate-sheet.mjs",
        "benchmark:climate": "bun ./scripts/benchmark-earth-climate.mjs",
        "check:climate": "bun ./scripts/check-climate.mjs && bun ./scripts/check-climate-physics.mjs && bun ./scripts/check-climate-mechanisms.mjs && bun ./scripts/check-climate-integration.mjs && bun ./scripts/check-climate-campaign.mjs && bun ./scripts/check-climate-benchmark-cli.mjs",
        "export:td": "bun ./scripts/export-td.mjs",
        "bake": "bun ./scripts/bake.mjs",
        "bake:tiles": "bun ./scripts/bake-tiles.mjs",
        "build": "bun build ./src/planet-generation.js --target=browser --minify --sourcemap=linked --outdir=build --entry-naming=_bundle.[ext]",
        "check:earth": "bun ./scripts/check-earth.mjs",
        "check:projects": "bun ./scripts/check-projects.mjs",
        "check:search": "bun ./scripts/check-search.mjs",
        "check:tiles": "bun ./scripts/check-tiles.mjs",
        "check:td": "bun ./scripts/check-td-overlay.mjs",
        "check:measure": "bun ./scripts/check-measure.mjs",
        "check:sculpt": "bun ./scripts/check-sculpt.mjs",
        "check:pipeline": "bun ./scripts/check-pipeline.mjs",
        "check:docs": "bun ./scripts/check-docs.mjs",
        "bake:campaign": "bun ./scripts/bake-campaign.mjs",
        "build:cubemap": "bun ./scripts/build-cubemap.mjs",
        "build:package": "bun ./scripts/build-package.mjs",
        "check:package": "bun ./scripts/check-package-pruning.mjs && bun ./scripts/check-package-output.mjs && bun ./scripts/check-package-reader.mjs && bun ./scripts/check-package-terrain.mjs",
        "build:previews": "bun ./scripts/build-previews.mjs"
    }
}
